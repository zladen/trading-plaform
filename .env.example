# Copy to `.env` and adjust the values. Never commit the resulting `.env`.
#
# Every value below is a placeholder. No credential in this file grants access to
# anything real; the development topology only listens on loopback.

# --- Application -----------------------------------------------------------

APP_ENV=development
APP_LOG_FORMAT=pretty
# JSON in containers, pretty locally.
RUST_LOG=info

# Origins allowed by the backend CORS layer. Comma separated, exact matches,
# wildcards are rejected by configuration validation.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# Swagger UI is served at /swagger-ui when enabled. It defaults to enabled
# outside production, so this only forces it off in a deployed environment.
APP_SWAGGER_ENABLED=true

# --- Published ports (loopback only by default) ----------------------------

# Bind address for the two published ports. Use 0.0.0.0 only when the platform
# must be reachable from another machine.
APP_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- PostgreSQL ------------------------------------------------------------

POSTGRES_DB=platform
POSTGRES_USER=platform
# Development-only password. Replace it anywhere that is not a laptop.
POSTGRES_PASSWORD=change-me-development-only

# --- Redis -----------------------------------------------------------------

# Redis is reachable only over the internal Docker network, so no password is
# configured for local development. Set one before exposing Redis at all.

# --- Frontend --------------------------------------------------------------

# The frontend talks to the same origin and nginx (or the Vite dev server)
# proxies /api, so no absolute API URL is required.
# VITE_API_URL=http://localhost:8080
# VITE_DEV_API_TARGET=http://127.0.0.1:8080

# --- Local (non-Docker) development ----------------------------------------

# Used when running `cargo run` against the Compose-managed dependencies.
# DATABASE_URL=postgres://platform:change-me-development-only@127.0.0.1:5432/platform
# REDIS_URL=redis://127.0.0.1:6379
# FRONTEND_URL=http://localhost:5173
