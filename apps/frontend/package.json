{
	"name": "@platform/frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"api:types": "openapi-typescript src/shared/api/generated/openapi.json -o src/shared/api/generated/schema.d.ts",
		"api:smoke": "node ../../tests/integration/smoke.mjs"
	},
	"dependencies": {
		"@hookform/resolvers": "7.0.9",
		"@radix-ui/react-slot": "1.5.0",
		"@tanstack/react-query": "5.108.4",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lightweight-charts": "5.3.0",
		"lucide-react": "1.80.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.92.0",
		"react-router": "8.5.3",
		"tailwind-merge": "3.7.1",
		"zod": "4.6.7",
		"zustand": "5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "8.0.0",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/node": "26.6.10",
		"@types/react": "19.3.2",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"eslint": "10.15.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-boundaries": "7.4.4",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.8",
		"globals": "17.14.0",
		"jsdom": "31.0.1",
		"openapi-typescript": "7.13.0",
		"prettier": "3.10.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.74.0",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
